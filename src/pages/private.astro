---
export const prerender = false;
import { writeFile, mkdir, readdir, unlink } from 'node:fs/promises';
import { resolve, basename } from 'node:path';

const secret = Astro.url.searchParams.get('secret') ?? '';
const validSecret = secret !== '' && secret === import.meta.env.UPLOAD_SECRET;
const imagesDir = resolve('./public/images');

let error = '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const s = (data.get('secret') as string) ?? '';
  const postValid = s !== '' && s === import.meta.env.UPLOAD_SECRET;

  if (postValid && data.get('_action') === 'delete') {
    const name = basename((data.get('file') as string) ?? '');
    if (name) await unlink(resolve(imagesDir, name)).catch(() => {});
    return Astro.redirect(`/private?secret=${encodeURIComponent(s)}`);
  }

  if (postValid) {
    const files = (data.getAll('image') as File[]).filter(f => f.size > 0);
    if (files.length > 0) {
      await mkdir(imagesDir, { recursive: true });
      for (const [i, file] of files.entries()) {
        const safe = file.name.replace(/[^a-z0-9._-]/gi, '_');
        const name = `${Date.now()}-${i}-${safe}`;
        await writeFile(resolve(imagesDir, name), Buffer.from(await file.arrayBuffer()));
      }
      return Astro.redirect(`/private?secret=${encodeURIComponent(s)}`);
    }
    error = 'Selecciona una imagen.';
  }
}

const images = validSecret
  ? (await readdir(imagesDir).catch(() => [] as string[]))
      .filter(f => /\.(jpe?g|png|webp|gif|avif)$/i.test(f))
  : [];
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Upload</title>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      min-height: 100vh;
      background: #080808;
      color: #fff;
      font-family: monospace;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .box {
      border: 1px solid rgba(255,255,255,0.15);
      padding: 2rem;
      width: min(420px, 90vw);
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    h1 { font-size: 0.9rem; letter-spacing: 0.15em; text-transform: uppercase; opacity: 0.5; }
    input[type="file"] { color: #fff; font: inherit; cursor: pointer; }
    input[type="password"] {
      width: 100%;
      background: none;
      border: 1px solid rgba(255,255,255,0.25);
      color: #fff;
      font: inherit;
      padding: 0.5rem;
      outline: none;
    }
    input[type="password"]:focus { border-color: rgba(255,255,255,0.6); }
    .actions { display: flex; gap: 0.75rem; }
    button {
      flex: 1;
      background: none;
      border: 1px solid rgba(255,255,255,0.35);
      color: #fff;
      font: inherit;
      padding: 0.5rem 1rem;
      cursor: pointer;
      transition: background 0.15s;
    }
    button:hover { background: rgba(255,255,255,0.08); }
    .err { color: #f66; font-size: 0.85rem; }

    .wrap { width: min(720px, 94vw); display: flex; flex-direction: column; gap: 1.5rem; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: 6px;
    }
    .thumb { position: relative; aspect-ratio: 1; }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .thumb form {
      position: absolute;
      top: 4px;
      right: 4px;
    }
    .thumb button.del {
      width: 1.6rem;
      height: 1.6rem;
      background: rgba(0,0,0,0.7);
      border: 1px solid rgba(255,255,255,0.4);
      color: #fff;
      cursor: pointer;
      line-height: 1;
    }
    .thumb button.del:hover { background: #a22; }

    /* modal */
    #secret-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      z-index: 10;
      align-items: center;
      justify-content: center;
    }
    #secret-modal.open { display: flex; }
    #secret-modal .box { background: #0e0e0e; }
  </style>
</head>
<body>

  {validSecret ? (
    <div class="wrap">
      <div class="box">
        <h1>Subir imagen a la galería</h1>
        <form method="POST" action={`/private?secret=${secret}`} enctype="multipart/form-data">
          <input type="hidden" name="secret" value={secret} />
          <input type="file" name="image" accept="image/*" multiple required />
          <br /><br />
          <button type="submit">Subir</button>
        </form>
        {error && <p class="err">{error}</p>}
      </div>

      <div class="grid">
        {images.map(f => (
          <div class="thumb">
            <img src={`/images/${f}`} alt="" loading="lazy" />
            <form method="POST" action={`/private?secret=${secret}`}>
              <input type="hidden" name="secret" value={secret} />
              <input type="hidden" name="_action" value="delete" />
              <input type="hidden" name="file" value={f} />
              <button type="submit" class="del" title="Borrar">×</button>
            </form>
          </div>
        ))}
      </div>
    </div>
  ) : (
    <div id="secret-modal" class="open">
      <div class="box">
        <h1>Acceso privado</h1>
        <input id="secret-input" type="password" placeholder="Secret" autofocus />
        <div class="actions">
          <button id="btn-cancel">Cancelar</button>
          <button id="btn-enter">Entrar</button>
        </div>
      </div>
    </div>
  )}

  {!validSecret && (
    <script>
      document.getElementById('btn-cancel').addEventListener('click', () => {
        window.location.href = '/';
      });
      document.getElementById('btn-enter').addEventListener('click', () => {
        const s = document.getElementById('secret-input').value.trim();
        if (s) window.location.href = `/private?secret=${encodeURIComponent(s)}`;
      });
      document.getElementById('secret-input').addEventListener('keydown', e => {
        if (e.key === 'Enter') document.getElementById('btn-enter').click();
      });
    </script>
  )}

</body>
</html>
